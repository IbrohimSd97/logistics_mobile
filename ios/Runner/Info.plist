<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<!-- Ilova tillari. Ruxsat so'rovlari matni {ru,uz}.lproj/InfoPlist.strings
	     da; qurilma tili ikkalasi ham bo'lmasa ruscha (App Store asosiy tili). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>uz</string>
	</array>
	<!-- Yandex MapKit kaliti — qiymat xcconfig'dan keladi (Secrets.xcconfig),
	     shuning uchun repoda ochiq saqlanmaydi. -->
	<key>YandexMapKitApiKey</key>
	<string>$(YANDEX_MAPKIT_API_KEY)</string>
	<!-- Buyurtma manzilini xaritada belgilash va haydovchi joylashuvini
	     kuzatish uchun. Bu matnlarsiz iOS ruxsat so'ramaydi. -->
	<key>NSCameraUsageDescription</key>
	<string>ALIX использует камеру, чтобы сфотографировать водительское удостоверение, селфи и автомобиль.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ALIX запрашивает доступ к галерее, чтобы выбрать фото документов.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ваше местоположение нужно, чтобы отметить адрес на карте и отслеживать доставку.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Во время выполнения заказа ваше местоположение используется, чтобы показывать клиенту статус доставки.</string>
	<key>CFBundleDisplayName</key>
	<string>ALIX</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ALIX</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Eksport muvofiqligi: faqat iOS'ning standart shifrlashi (HTTPS), o'zimizning
	     algoritm yo'q — App Store Connect'da "Missing Compliance" so'ralmaydi. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Push: ilova fonda bo'lsa ham FCM xabarini qabul qilish uchun. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
