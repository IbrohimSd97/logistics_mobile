<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ da tizim splash API'si ishlaydi: `windowBackground` e'tiborsiz
     qoldiriladi, uning o'rniga fon rangi va markazdagi ikonka beriladi. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/alix_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
